<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Barra superior con fondo del color de los botones -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#EC8F01">

        <!-- TextView para "Cerrar sesión" -->
        <TextView
            android:id="@+id/textViewCerrarSesion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:text="Cerrar sesión"
            android:textColor="@android:color/white"
            android:textSize="20sp" />

        <!-- TextView para "Salir" -->
        <TextView
            android:id="@+id/textViewSalir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:text="Salir"
            android:textColor="@android:color/white"
            android:textSize="20sp" />
    </RelativeLayout>

    <!-- Imagen de fondo -->
    <ImageView
        android:id="@+id/imageViewBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:scaleType="fitCenter"
        android:src="@drawable/imgkuka" />

    <!-- Botón para acceder a guías -->
    <Button
        android:id="@+id/buttonGuiaCambioFormato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:backgroundTint="#EC8F01"
        android:text="Guía Cambio de Formato"
        android:textColor="@android:color/white"
        android:textSize="20sp" />

    <!-- Botón para acceder a manuales -->
    <Button
        android:id="@+id/buttonProcedimientosManuales"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/buttonGuiaCambioFormato"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:backgroundTint="#EC8F01"
        android:text="Procedimientos y Manuales"
        android:textColor="@android:color/white"
        android:textSize="20sp" />
</RelativeLayout>
