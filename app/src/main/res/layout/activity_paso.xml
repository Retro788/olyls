<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Título de la guía -->
    <TextView
        android:id="@+id/textViewTituloGuia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Título de la Guía"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="8dp"
        android:layout_marginBottom="8dp" />

    <!-- Descripción del paso -->
    <TextView
        android:id="@+id/textViewDescripcionPaso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Descripción del Paso"
        android:textSize="18sp"
        android:layout_marginBottom="16dp" />

    <!-- Imagen del paso -->
    <ImageView
        android:id="@+id/imageViewPaso"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:scaleType="fitCenter"
        android:src="@drawable/placeholder" />

    <!-- Botones de navegación -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/buttonAnteriorPaso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Anterior"
            android:minWidth="48dp"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/buttonSiguientePaso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Siguiente"
            android:layout_marginStart="16dp"
            android:minWidth="48dp"
            android:minHeight="48dp" />
    </LinearLayout>

    <!-- Botón para agregar un nuevo paso -->
    <Button
        android:id="@+id/buttonAgregarPaso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Agregar Paso"
        android:layout_marginTop="16dp"
        android:minWidth="48dp"
        android:minHeight="48dp" />
</LinearLayout>
